<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nạp được các dylib sherpa/onnxruntime trong bundle (chứng chỉ tự ký không có Team ID).
	     Thay/tiêm dylib khác vẫn làm hỏng chữ ký bundle → bước tự kiểm tra chữ ký bắt được. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
