# Chép thành .env rồi sửa. Không commit .env.

# Tên miền công khai (đi qua Cloudflare về nginx), dùng để chặn CSRF ở trang quản trị.
PUBLIC_HOST=translate.helioapple.com

# Mật khẩu trang quản trị https://PUBLIC_HOST/admin (ít nhất 12 ký tự).
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# Số ngày máy đã duyệt dùng được khi tạm mất mạng.
TICKET_DAYS=7

# Tuỳ chọn: báo Telegram khi có máy mới chờ duyệt.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
