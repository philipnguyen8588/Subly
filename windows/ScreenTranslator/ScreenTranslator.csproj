<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ScreenTranslator</RootNamespace>
    <AssemblyName>ScreenTranslator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Product>ScreenTranslator</Product>
    <NoWarn>$(NoWarn);CA1416;CS8618;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Ed25519 (khoá thiết bị + kiểm vé server). .NET 8 chưa có Ed25519 sẵn. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <!-- Sinh Core\RuntimeConfigValues.cs (cấu hình server nhúng lúc build) nếu chưa có, để `dotnet build` chạy độc lập
       vẫn biên dịch được (cấu hình rỗng = bản dùng riêng, không kiểm tra máy). build.ps1 gọi gen-runtime-config.ps1
       với subly.local.env để sinh cấu hình thật của bản phát hành. -->
  <Target Name="GenRuntimeConfig" BeforeTargets="BeforeBuild" Condition="!Exists('Core\RuntimeConfigValues.cs')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Scripts\gen-runtime-config.ps1&quot;" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Web\WebPage.html" LogicalName="WebPage.html" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppIcon.png" />
  </ItemGroup>

  <!-- Danh sách từ tiếng Anh (thay /usr/share/dict/words), tải bằng Scripts/fetch-words.ps1. Không có thì bỏ qua. -->
  <ItemGroup Condition="Exists('Resources\words.txt')">
    <None Include="Resources\words.txt" CopyToOutputDirectory="PreserveNewest" Link="words.txt" />
  </ItemGroup>

  <!-- Thuật ngữ game đóng kèm (glossaries/ ở gốc repo, dùng chung với bản macOS). Chép vào glossaries/ cạnh exe;
       GameGlossaries.cs đọc để tạo sẵn profile lần đầu chạy. -->
  <ItemGroup Condition="Exists('..\..\glossaries')">
    <None Include="..\..\glossaries\*.csv" CopyToOutputDirectory="PreserveNewest" Link="glossaries\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Thư viện native: sherpa-onnx (giọng offline) và st_chiaki (PS5). Chưa có thì app vẫn build, tính năng báo "chưa cài". -->
  <ItemGroup>
    <None Include="..\Vendor\sherpa-onnx\lib\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Condition="Exists('..\Vendor\sherpa-onnx\lib')" />
    <None Include="..\Vendor\st_chiaki\bin\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Condition="Exists('..\Vendor\st_chiaki\bin')" />
  </ItemGroup>

</Project>
